rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // HELPER FUNCTIONS
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidNotModified() {
      return !('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // DOMAIN VALIDATORS
    // ===============================================================
    
    // 2. Validar campos obrigatórios e tipos
    // 3. Limitar tamanho de strings (title máx 200 chars)
    function isValidTask(data) {
      let isAllowedKeys = hasOnlyAllowedFields(['userId', 'title', 'completed', 'createdAt', 'order', 'category']);
      return isAllowedKeys &&
             data.userId is string &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 && // Limite de 200 chars
             data.completed is bool &&
             (data.createdAt is number || data.createdAt is timestamp) && // Aceita Date.now() ou serverTimestamp()
             (!('order' in data) || data.order is number) &&
             (!('category' in data) || data.category is string);
    }

    function isValidMemory(data) {
      return hasOnlyAllowedFields(['userId', 'title', 'content', 'createdAt']) &&
             data.userId is string &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 5000 &&
             (data.createdAt is number || data.createdAt is timestamp);
    }

    function isValidGameState(data) {
      return data.keys().hasAll(['updatedAt']) &&
             (data.updatedAt is number || data.updatedAt is timestamp);
    }

    function isValidErrorLog(data) {
      return hasOnlyAllowedFields(['userId', 'message', 'stack', 'timestamp']) &&
             data.userId is string &&
             data.message is string && data.message.size() <= 1000 &&
             data.stack is string && data.stack.size() <= 5000 &&
             (data.timestamp is timestamp);
    }

    // ===============================================================
    // RULES FOR SUBCOLLECTIONS (As requested: users/{userId}/*)
    // ===============================================================
    
    match /users/{userId} {
      // 1. Garantir que userId no path bate com auth.uid
      allow read: if isOwner(userId);
      allow write: if false; // Perfil raiz requer Cloud Function ou Admin SDK para segurança

      // users/{userId}/tasks
      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        // Validar tipo, limite de string, e matching de owner no write
        allow create: if isOwner(userId) && isValidTask(request.resource.data) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidTask(request.resource.data) && uidNotModified();
        allow delete: if isOwner(userId);
      }

      // users/{userId}/memories
      match /memories/{memoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidMemory(request.resource.data) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidMemory(request.resource.data) && uidNotModified();
        allow delete: if isOwner(userId);
      }

      // users/{userId}/achievements (New Module)
      match /achievements/{docId} {
        allow read, write: if isOwner(userId);
      }
      
      // users/{userId}/stats (New Module)
      match /stats/{docId} {
        allow read, write: if isOwner(userId);
      }

      // users/{userId}/gameState
      match /gameState/{stateId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidGameState(request.resource.data);
      }

      // 4. RATE LIMITING VIA CONTADOR DE ESCRITA:
      // O Firestore local não tem "contadores temporais" nativos na mesma query. 
      // A arquitetura para isso exige que cada 'write' num documento exija
      // um batch update numa coleção "writeTokens/counter".
      // Exemplo de regra para garantir que o cliente está incrementando:
      // match /writeCounter/{counterId} {
      //   allow update: if isOwner(userId) && 
      //                 request.resource.data.count == resource.data.count + 1 &&
      //                 request.time > resource.data.lastWriteTime + duration.time(0, 0, 0, 5); // delay de 5 seg
      // }
    }

    // ===============================================================
    // FALLBACK RULES (Current App Architecture using Root Collections)
    // Maintain these so your existing Keeper OS App.tsx and Tasks.tsx 
    // don't break until you refactor them to point to users/{userId}/*
    // ===============================================================

    match /tasks/{taskId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isValidTask(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidTask(request.resource.data) && uidNotModified();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /memories/{memoryId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isValidMemory(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidMemory(request.resource.data) && uidNotModified();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /errorLogs/{logId} {
      allow create: if request.resource.data.userId == (isAuthenticated() ? request.auth.uid : 'anonymous') &&
                       isValidErrorLog(request.resource.data);
      allow read, update, delete: if false; // Write-only for security logs
    }
    
    match /stats/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }
    
    // Configurações do tech tree e dados do jogador (Root architecture)
    match /userTechs/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /userSettings/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /systemLogs/{logId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /chatSessions/{sessionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && uidNotModified();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && get(/databases/$(database)/documents/chatSessions/$(sessionId)).data.userId == request.auth.uid;
        allow create: if isAuthenticated() && get(/databases/$(database)/documents/chatSessions/$(sessionId)).data.userId == request.auth.uid;
        allow update, delete: if false; // Chat Messages are append only
      }
    }

  }
}
